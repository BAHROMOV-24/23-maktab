# ===== Supabase (Project Settings -> API Keys) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# "Publishable key" (sb_publishable_...). Ommaviy, brauzerga chiqishi mumkin
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_...). FAQAT server! Hech qachon NEXT_PUBLIC_ bilan boshlamang
SUPABASE_SERVICE_ROLE_KEY=

# ===== Sayt =====
# Sayt manzili (SEO, sitemap, Telegram ulashish). Vercel'da haqiqiy domen yoziladi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Cron (keep-alive) uchun maxfiy kalit: istalgan uzun tasodifiy qator
CRON_SECRET=

# ===== Birinchi superadmin (npm run seed uchun) =====
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ===== Faqat shu kompyuterda, migratsiya uchun (Vercel'ga KIRITMANG) =====
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Loyiha yaratishda berilgan database paroli
SUPABASE_DB_PASSWORD=
